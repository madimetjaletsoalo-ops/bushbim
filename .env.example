DATABASE_URL="postgresql://bushbim:bushbim@localhost:5432/bushbim?schema=bushbim"
DIRECT_URL="postgresql://bushbim:bushbim@localhost:5432/bushbim?schema=bushbim"
# 32+ random characters; generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-please"

# Document Control file storage (S3 / MinIO / Supabase Storage).
# Leave S3_BUCKET empty to store files on local disk in ./.storage (dev and tests only).
# For the docker-compose MinIO: create the bucket in the console (http://localhost:9001) and allow CORS.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Daily Logs weather. Leave empty to use Open-Meteo (no key needed); "off" disables the lookup.
# The e2e tests point this at a local stand-in (tests/e2e/mock-open-meteo.mjs).
OPEN_METEO_URL=""
