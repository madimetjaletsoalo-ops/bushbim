// BushBIM core data model.
// Foundation + Project Admin. Document Control and Field Management models
// are added by later backlog items (see BACKLOG.md).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: runtime connection (on Supabase, the pooled port 6543 URL with ?pgbouncer=true).
// DIRECT_URL: direct connection used by migrations (on Supabase, the session/direct port 5432 URL).
// Locally both point at the same database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A customer organisation (e.g. the resort developer). Owns companies, roles and projects.
model Account {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  companies Company[]
  roles     Role[]
  projects  Project[]
}

enum AccountRole {
  ACCOUNT_ADMIN
  USER
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String
  /// null until the invited user sets a password
  passwordHash         String?
  /// one-time token for the invite link; cleared once the password is set
  inviteToken          String?                @unique
  accountId            String
  account              Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountRole          AccountRole            @default(USER)
  createdAt            DateTime               @default(now())
  memberships          ProjectMember[]
  auditEvents          AuditEvent[]
  folders              Folder[]
  versions             DocumentVersion[]
  markups              Markup[]
  calibrations         SheetCalibration[]
  reviewsStarted       Review[]
  reviewDecisions      ReviewDecision[]
  transmittalsSent     Transmittal[]
  transmittalsReceived TransmittalRecipient[]
  issuesCreated        Issue[]                @relation("IssuesCreated")
  issuesWatched        IssueWatcher[]
  issueComments        IssueComment[]
  issuePins            IssuePin[]
  photos               Photo[]
  checklistTemplates   ChecklistTemplate[]
  checklistsCreated    Checklist[]            @relation("ChecklistsCreated")
  checklistsCompleted  Checklist[]            @relation("ChecklistsCompleted")
  checklistAnswers     ChecklistItem[]
  dailyLogsCreated     DailyLog[]             @relation("DailyLogsCreated")
  dailyLogsPublished   DailyLog[]             @relation("DailyLogsPublished")
  dailyLogLabour       DailyLogLabour[]
  dailyLogAnswers      DailyLogItem[]
}

/// A trade / organisation working on projects (GC, architect, MEP sub, ...).
model Company {
  id             String           @id @default(cuid())
  accountId      String
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  trade          String?
  country        String?
  createdAt      DateTime         @default(now())
  members        ProjectMember[]
  dailyLogLabour DailyLogLabour[]

  @@unique([accountId, name])
}

model Role {
  id        String       @id @default(cuid())
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  members   MemberRole[]

  @@unique([accountId, name])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id                 String                 @id @default(cuid())
  accountId          String
  account            Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name               String
  code               String?
  type               String?
  location           String?
  country            String?
  currency           String                 @default("ZAR")
  timezone           String                 @default("Africa/Johannesburg")
  startDate          DateTime?
  endDate            DateTime?
  status             ProjectStatus          @default(ACTIVE)
  /// cover photo shown in the project list, e.g. "/projects/kruger-lodge-villas.webp"
  coverImage         String?
  /// site coordinates (decimal degrees), used for Daily Log weather
  latitude           Float?
  longitude          Float?
  createdAt          DateTime               @default(now())
  members            ProjectMember[]
  permissions        ServicePermission[]
  auditEvents        AuditEvent[]
  folders            Folder[]
  documents          Document[]
  sheets             Sheet[]
  sheetSets          SheetSet[]
  titleBlock         TitleBlockSettings?
  reviewWorkflows    ReviewWorkflow[]
  reviews            Review[]
  transmittals       Transmittal[]
  locations          Location[]
  issueTypes         IssueType[]
  issueStatuses      IssueStatus[]
  issueRootCauses    IssueRootCause[]
  issueAttributes    IssueAttribute[]
  issues             Issue[]
  photos             Photo[]
  checklistTemplates ChecklistTemplate[]
  checklists         Checklist[]
  dailyLogSettings   DailyLogSettings?
  dailyLogItems      DailyLogTemplateItem[]
  dailyLogs          DailyLog[]
  documentTexts      DocumentText[]

  @@unique([accountId, name])
}

enum AccessLevel {
  PROJECT_ADMIN
  MEMBER
}

enum MemberStatus {
  INVITED
  ACTIVE
}

model ProjectMember {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  accessLevel AccessLevel  @default(MEMBER)
  status      MemberStatus @default(INVITED)
  /// Services this member can open at all (see Service enum)
  services    Service[]
  addedAt     DateTime     @default(now())
  roles       MemberRole[]

  @@unique([projectId, userId])
}

model MemberRole {
  memberId String
  member   ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
}

enum Service {
  DOCS
  ISSUES
  CHECKLISTS
  DAILY_LOGS
}

enum SubjectType {
  USER
  ROLE
  COMPANY
}

/// Ordered: NONE < VIEWER < CREATOR < MANAGER
enum PermissionLevel {
  NONE
  VIEWER
  CREATOR
  MANAGER
}

/// Per-service permission granted to a user, role or company within a project.
/// A member's effective level is the highest grant that applies to them.
model ServicePermission {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service     Service
  subjectType SubjectType
  subjectId   String
  level       PermissionLevel

  @@unique([projectId, service, subjectType, subjectId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// ---------- Document Control ----------

/// The two top-level folders every project starts with.
enum FolderRoot {
  PLANS
  PROJECT_FILES
}

/// A folder in a project's document tree. Root folders have `root` set and no parent.
model Folder {
  id                 String             @id @default(cuid())
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId           String?
  parent             Folder?            @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           Folder[]           @relation("FolderTree")
  root               FolderRoot?
  name               String
  createdById        String?
  createdBy          User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          Document[]
  permissions        FolderPermission[]
  autoStartWorkflows ReviewWorkflow[]   @relation("WorkflowAutoStart")
  approvedWorkflows  ReviewWorkflow[]   @relation("WorkflowApproved")

  @@unique([projectId, root])
  @@unique([parentId, name])
  @@index([projectId])
}

/// A named file in a folder. Uploading the same name again stacks a new version.
model Document {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId       String
  folder         Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name           String
  /// lower-cased name: "Site Plan.pdf" and "site plan.PDF" stack as one document
  nameKey        String
  /// latest version number and its size/type, kept here for listing and sorting
  currentVersion Int               @default(1)
  size           Int               @default(0)
  contentType    String            @default("application/octet-stream")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now())
  versions       DocumentVersion[]

  @@unique([folderId, nameKey])
  @@index([projectId])
}

model DocumentVersion {
  id                   String                @id @default(cuid())
  documentId           String
  document             Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  number               Int
  /// object key in S3/MinIO (or the local storage directory)
  storageKey           String                @unique
  /// file name as uploaded for this version
  fileName             String
  size                 Int
  contentType          String
  uploadedById         String?
  uploadedBy           User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  markups              Markup[]
  calibrations         SheetCalibration[]
  sheets               Sheet[]
  reviewDocuments      ReviewDocument[]
  transmittalDocuments TransmittalDocument[]
  issuePins            IssuePin[]
  text                 DocumentText?

  @@unique([documentId, number])
}

/// Ordered: NONE < VIEW < VIEW_DOWNLOAD < UPLOAD < EDIT < MANAGE
enum FolderLevel {
  NONE
  VIEW
  VIEW_DOWNLOAD
  UPLOAD
  EDIT
  MANAGE
}

/// DEFAULT = every project member with Document Control (subjectId "*").
enum FolderSubjectType {
  DEFAULT
  USER
  ROLE
  COMPANY
}

/// A folder-level grant. Applies to the folder and its subfolders until a
/// subfolder sets its own grant for the same subject.
model FolderPermission {
  id          String            @id @default(cuid())
  folderId    String
  folder      Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  subjectType FolderSubjectType
  subjectId   String
  level       FolderLevel
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([folderId, subjectType, subjectId])
  @@index([folderId])
}

enum MarkupType {
  PEN
  RECT
  CLOUD
  ARROW
  TEXT
  LENGTH
  AREA
}

enum MarkupStatus {
  PRIVATE
  PUBLISHED
}

/// A markup on one page of a document version. Coordinates are in page units:
/// PDF points at 100% zoom, or image pixels.
model Markup {
  id        String          @id @default(cuid())
  versionId String
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page      Int
  type      MarkupType
  /// [[x, y], ...] in page units
  points    Json
  color     String
  text      String?
  status    MarkupStatus    @default(PRIVATE)
  authorId  String?
  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([versionId, page])
}

/// Drawing scale for one page of a version: `unitsPerPoint` real units per page unit.
model SheetCalibration {
  id            String          @id @default(cuid())
  versionId     String
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page          Int
  unitsPerPoint Float
  unit          String
  setById       String?
  setBy         User?           @relation(fields: [setById], references: [id], onDelete: SetNull)
  updatedAt     DateTime        @updatedAt

  @@unique([versionId, page])
}

/// One page of a PDF (or an image) uploaded under Plans. Each version gets its own sheets.
model Sheet {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId String
  version   DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page      Int
  number    String
  title     String
  /// true once someone edits the number or title; re-reading the title block then leaves it alone
  edited    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sets      SetSheet[]

  @@unique([versionId, page])
  @@index([projectId, number])
}

/// A named group of sheet versions, e.g. "Tender" or "IFC Rev B".
model SheetSet {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  sheets    SetSheet[]

  @@unique([projectId, name])
}

model SetSheet {
  setId   String
  set     SheetSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  sheetId String
  sheet   Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([setId, sheetId])
}

/// Where the sheet number and title sit on this project's drawings:
/// {x, y, w, h} as fractions of the page, origin top-left.
model TitleBlockSettings {
  projectId    String   @id
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  numberRegion Json
  titleRegion  Json
  updatedAt    DateTime @updatedAt
}

// ---------- Reviews ----------

/// Ordered from best to worst; a step's result for a file is the worst decision it got.
enum ReviewOutcome {
  APPROVED
  APPROVED_WITH_COMMENTS
  REVISE_RESUBMIT
  REJECTED
}

enum ReviewStatus {
  OPEN
  CLOSED
}

/// ANY: the first reviewer to respond completes the step. ALL: every reviewer must respond.
enum ReviewStepMode {
  ANY
  ALL
}

/// An approval workflow defined by a project admin: 1–5 steps, who may start it, and options.
model ReviewWorkflow {
  id                String               @id @default(cuid())
  projectId         String
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  /// approval statuses reviewers can pick: [{ code: ReviewOutcome, label: string }]
  statuses          Json
  /// who may start reviews: ["USER:id", "ROLE:id", "COMPANY:id"]; empty = any Document Control Creator
  initiators        Json                 @default("[]")
  /// uploads to this folder start a review automatically
  autoStartFolderId String?
  autoStartFolder   Folder?              @relation("WorkflowAutoStart", fields: [autoStartFolderId], references: [id], onDelete: SetNull)
  /// approved files are copied here when the review closes
  approvedFolderId  String?
  approvedFolder    Folder?              @relation("WorkflowApproved", fields: [approvedFolderId], references: [id], onDelete: SetNull)
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  steps             ReviewWorkflowStep[]
  reviews           Review[]

  @@unique([projectId, name])
  @@index([autoStartFolderId])
}

model ReviewWorkflowStep {
  id         String         @id @default(cuid())
  workflowId String
  workflow   ReviewWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  /// 1-based
  order      Int
  name       String
  /// ["USER:id", "ROLE:id", "COMPANY:id"]
  reviewers  Json
  mode       ReviewStepMode @default(ANY)
  /// days allowed for this step, used for the due date
  days       Int            @default(5)

  @@unique([workflowId, order])
}

model Review {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId  String
  workflow    ReviewWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  /// per-project sequence shown as #1, #2…
  number      Int
  name        String
  status      ReviewStatus     @default(OPEN)
  currentStep Int              @default(1)
  stepDueAt   DateTime?
  initiatorId String?
  initiator   User?            @relation(fields: [initiatorId], references: [id], onDelete: SetNull)
  autoStarted Boolean          @default(false)
  createdAt   DateTime         @default(now())
  closedAt    DateTime?
  documents   ReviewDocument[]
  decisions   ReviewDecision[]

  @@unique([projectId, number])
  @@index([projectId, status])
}

/// A document version under review, with its final outcome once the review closes.
model ReviewDocument {
  id              String           @id @default(cuid())
  reviewId        String
  review          Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  versionId       String
  version         DocumentVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  outcome         ReviewOutcome?
  /// the copy made in the workflow's "approved" folder, if any
  copiedVersionId String?
  decisions       ReviewDecision[]

  @@unique([reviewId, versionId])
  @@index([versionId])
}

/// One reviewer's decision on one file at one step.
model ReviewDecision {
  id               String         @id @default(cuid())
  reviewId         String
  review           Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewDocumentId String
  reviewDocument   ReviewDocument @relation(fields: [reviewDocumentId], references: [id], onDelete: Cascade)
  step             Int
  reviewerId       String
  reviewer         User           @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  outcome          ReviewOutcome
  comment          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([reviewDocumentId, step, reviewerId])
  @@index([reviewId, step])
}

// ---------- Transmittals ----------

/// A set of document versions sent to members or external email addresses.
/// Each recipient gets a no-login download link that stops working at `expiresAt` or when revoked.
model Transmittal {
  id         String                 @id @default(cuid())
  projectId  String
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// per-project sequence shown as T-1, T-2…
  number     Int
  subject    String
  message    String?
  senderId   String?
  sender     User?                  @relation(fields: [senderId], references: [id], onDelete: SetNull)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime               @default(now())
  documents  TransmittalDocument[]
  recipients TransmittalRecipient[]
  downloads  TransmittalDownload[]

  @@unique([projectId, number])
  @@index([projectId, createdAt])
}

/// A version included in a transmittal. Name and number are copied so the log
/// still reads correctly if the file is later deleted (versionId then becomes null).
model TransmittalDocument {
  id            String                @id @default(cuid())
  transmittalId String
  transmittal   Transmittal           @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  versionId     String?
  version       DocumentVersion?      @relation(fields: [versionId], references: [id], onDelete: SetNull)
  fileName      String
  versionNumber Int
  size          Int
  downloads     TransmittalDownload[]

  @@unique([transmittalId, versionId])
  @@index([versionId])
}

/// Someone a transmittal was sent to: a project member (userId set) or an external email address.
/// The download link is derived from the id and SESSION_SECRET, so no token is stored.
model TransmittalRecipient {
  id            String                @id @default(cuid())
  transmittalId String
  transmittal   Transmittal           @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// lower-cased
  email         String
  name          String?
  firstOpenedAt DateTime?
  downloads     TransmittalDownload[]

  @@unique([transmittalId, email])
  @@index([userId])
}

/// One download of one file through a recipient's link: the transmittal log.
model TransmittalDownload {
  id            String               @id @default(cuid())
  transmittalId String
  transmittal   Transmittal          @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  recipientId   String
  recipient     TransmittalRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  documentId    String
  document      TransmittalDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())

  @@index([transmittalId, createdAt])
}

// ---------- Issues ----------

/// A place in the project: Site → Zone → Villa/Suite → Room. Item 16 adds CSV import.
model Location {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Location?   @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Location[]  @relation("LocationTree")
  name       String
  createdAt  DateTime    @default(now())
  issues     Issue[]
  checklists Checklist[]

  @@unique([projectId, parentId, name])
  @@index([projectId])
}

model IssueType {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  subtypes  IssueSubtype[]
  issues    Issue[]

  @@unique([projectId, name])
}

model IssueSubtype {
  id        String    @id @default(cuid())
  typeId    String
  type      IssueType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  issues    Issue[]

  @@unique([typeId, name])
}

/// ⭐ Per-project issue statuses: renameable, addable, with optional sub-statuses (parentId set).
model IssueStatus {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    IssueStatus?  @relation("StatusTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  IssueStatus[] @relation("StatusTree")
  name      String
  /// "#rrggbb", used for the status bar in the issue table
  color     String
  /// issues in a closed status are not overdue and get `closedAt`
  closed    Boolean       @default(false)
  /// issues in a draft status are visible only to their creator and Issues Managers
  draft     Boolean       @default(false)
  /// the status new issues start in (one per project)
  isDefault Boolean       @default(false)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  issues    Issue[]

  @@unique([projectId, name])
  @@index([projectId, order])
}

model IssueRootCause {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  issues    Issue[]

  @@unique([projectId, name])
}

enum IssueAttributeKind {
  TEXT
  NUMBER
  DATE
  LIST
}

/// A custom attribute shown on every issue in the project. Values live in `Issue.attributes`.
model IssueAttribute {
  id        String             @id @default(cuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  kind      IssueAttributeKind
  /// LIST only: the allowed values
  options   Json               @default("[]")
  createdAt DateTime           @default(now())

  @@unique([projectId, name])
}

model Issue {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// per-project sequence shown as #1, #2…
  number        Int
  title         String
  description   String?
  typeId        String?
  type          IssueType?      @relation(fields: [typeId], references: [id], onDelete: SetNull)
  subtypeId     String?
  subtype       IssueSubtype?   @relation(fields: [subtypeId], references: [id], onDelete: SetNull)
  statusId      String
  status        IssueStatus     @relation(fields: [statusId], references: [id], onDelete: Restrict)
  /// assigned to a user, a role or a company
  assigneeType  SubjectType?
  assigneeId    String?
  dueDate       DateTime?       @db.Date
  locationId    String?
  location      Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rootCauseId   String?
  rootCause     IssueRootCause? @relation(fields: [rootCauseId], references: [id], onDelete: SetNull)
  /// custom attribute values: { [IssueAttribute.id]: string }
  attributes    Json            @default("{}")
  createdById   String?
  createdBy     User?           @relation("IssuesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  closedAt      DateTime?
  watchers      IssueWatcher[]
  comments      IssueComment[]
  pin           IssuePin?
  photos        Photo[]
  /// set when the issue was raised from a failed checklist item
  checklistItem ChecklistItem?

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([projectId, createdAt])
}

model IssueWatcher {
  issueId String
  issue   Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([issueId, userId])
  @@index([userId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

/// Where an issue sits on a sheet: one pin per issue, on a page of a document version.
model IssuePin {
  id          String          @id @default(cuid())
  issueId     String          @unique
  issue       Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  versionId   String
  version     DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page        Int
  /// position in page units (PDF points at zoom 1, or image pixels), like markups
  x           Float
  y           Float
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([versionId, page])
}

/// A site photo, compressed in the browser to a JPEG at most 1600 px wide plus a small thumbnail.
/// Attached to an issue, or a plain project photo when issueId is null.
model Photo {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueId         String?
  issue           Issue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  /// set for a photo answering a checklist's photo item
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  /// set for a photo on a daily log
  dailyLogId      String?
  dailyLog        DailyLog?      @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  storageKey      String         @unique
  thumbKey        String         @unique
  fileName        String
  width           Int
  height          Int
  size            Int
  caption         String?
  uploadedById    String?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([projectId, createdAt])
  @@index([issueId])
  @@index([checklistItemId])
  @@index([dailyLogId])
}

// ---------- Checklists ----------

enum ChecklistItemKind {
  /// Yes / No / N/A; "No" is a failed item and can raise an issue
  YES_NO
  TEXT
  NUMBER
  DATE
  SIGNATURE
  PHOTO
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// A reusable checklist design: sections holding items. Built by Checklists Managers.
model ChecklistTemplate {
  id          String                     @id @default(cuid())
  projectId   String
  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// archived templates stay on existing checklists but can't be used for new ones
  archived    Boolean                    @default(false)
  createdById String?
  createdBy   User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  sections    ChecklistTemplateSection[]
  checklists  Checklist[]

  @@unique([projectId, name])
}

model ChecklistTemplateSection {
  id         String                  @id @default(cuid())
  templateId String
  template   ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  order      Int                     @default(0)
  items      ChecklistTemplateItem[]

  @@index([templateId, order])
}

model ChecklistTemplateItem {
  id        String                   @id @default(cuid())
  sectionId String
  section   ChecklistTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String
  kind      ChecklistItemKind
  required  Boolean                  @default(false)
  order     Int                      @default(0)

  @@index([sectionId, order])
}

/// A checklist created from a template. Its sections and items are copied from the
/// template when it is created, so later template edits don't change it.
model Checklist {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// per-project sequence shown as CL-1, CL-2…
  number        Int
  title         String
  templateId    String?
  template      ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// the template's name when the checklist was created
  templateName  String
  status        ChecklistStatus    @default(NOT_STARTED)
  /// assigned to a user or a company
  assigneeType  SubjectType?
  assigneeId    String?
  locationId    String?
  location      Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  dueDate       DateTime?          @db.Date
  createdById   String?
  createdBy     User?              @relation("ChecklistsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  completedAt   DateTime?
  completedById String?
  completedBy   User?              @relation("ChecklistsCompleted", fields: [completedById], references: [id], onDelete: SetNull)
  sections      ChecklistSection[]
  items         ChecklistItem[]

  @@unique([projectId, number])
  @@index([projectId, status])
}

model ChecklistSection {
  id          String          @id @default(cuid())
  checklistId String
  checklist   Checklist       @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  order       Int             @default(0)
  items       ChecklistItem[]

  @@index([checklistId, order])
}

model ChecklistItem {
  id           String            @id @default(cuid())
  checklistId  String
  checklist    Checklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  sectionId    String
  section      ChecklistSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label        String
  kind         ChecklistItemKind
  required     Boolean           @default(false)
  order        Int               @default(0)
  /// YES_NO: "YES" | "NO" | "NA"; TEXT/NUMBER: the text; DATE: "YYYY-MM-DD";
  /// SIGNATURE: a small PNG data URL; PHOTO: unused (see photos)
  value        String?
  note         String?
  answeredById String?
  answeredBy   User?             @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?
  /// the issue raised from this item when it failed
  issueId      String?           @unique
  issue        Issue?            @relation(fields: [issueId], references: [id], onDelete: SetNull)
  photos       Photo[]

  @@index([checklistId, order])
}

// ---------- Daily Logs ----------

/// Per-project Daily Log settings (Daily Logs Managers).
model DailyLogSettings {
  projectId       String   @id
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// publishing needs the work carried out to be filled in
  workLogRequired Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

enum DailyLogItemKind {
  /// Yes / No / N/A
  YES_NO
  TEXT
  NUMBER
}

/// A custom checklist item admins add to the log template. Copied into each new log.
model DailyLogTemplateItem {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  kind      DailyLogItemKind @default(YES_NO)
  required  Boolean          @default(false)
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([projectId, order])
}

enum DailyLogStatus {
  DRAFT
  PUBLISHED
}

enum WeatherSource {
  /// fetched from Open-Meteo for the project's coordinates
  AUTO
  /// typed in, or an automatic reading edited by hand
  MANUAL
}

/// One log per project per calendar day (in the project's time zone).
model DailyLog {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// the calendar day, stored as UTC midnight
  date          DateTime            @db.Date
  status        DailyLogStatus      @default(DRAFT)
  weatherSource WeatherSource?
  weatherCode   Int?
  /// e.g. "Partly cloudy", "Thunderstorm"
  conditions    String?
  tempMin       Float?
  tempMax       Float?
  /// millimetres
  precipitation Float?
  /// km/h
  windMax       Float?
  weatherNote   String?
  /// work carried out today (the work log)
  workSummary   String?
  notes         String?
  createdById   String?
  createdBy     User?               @relation("DailyLogsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?               @relation("DailyLogsPublished", fields: [publishedById], references: [id], onDelete: SetNull)
  labour        DailyLogLabour[]
  equipment     DailyLogEquipment[]
  visitors      DailyLogVisitor[]
  items         DailyLogItem[]
  photos        Photo[]

  @@unique([projectId, date])
}

/// Labour and work for one company (or crew) on the day. Subcontractors fill in their own.
model DailyLogLabour {
  id          String   @id @default(cuid())
  logId       String
  log         DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// the company's name when the row was written (or a crew name without a company)
  companyName String
  trade       String?
  headcount   Int
  hours       Float
  /// the work this company carried out
  work        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([logId])
}

model DailyLogEquipment {
  id        String   @id @default(cuid())
  logId     String
  log       DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  hours     Float?
  notes     String?
  createdAt DateTime @default(now())

  @@index([logId])
}

model DailyLogVisitor {
  id           String   @id @default(cuid())
  logId        String
  log          DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  name         String
  organisation String?
  purpose      String?
  /// "HH:MM"
  arrivedAt    String?
  leftAt       String?
  createdAt    DateTime @default(now())

  @@index([logId])
}

/// A custom checklist item on a log, copied from the template when the log was started.
model DailyLogItem {
  id           String           @id @default(cuid())
  logId        String
  log          DailyLog         @relation(fields: [logId], references: [id], onDelete: Cascade)
  label        String
  kind         DailyLogItemKind
  required     Boolean          @default(false)
  order        Int              @default(0)
  /// YES_NO: "YES" | "NO" | "NA"; TEXT / NUMBER: the text
  value        String?
  answeredById String?
  answeredBy   User?            @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?

  @@index([logId, order])
}

// ---------- Full-text search ----------

enum TextIndexStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  SKIPPED
}

enum TextIndexMethod {
  PDF_TEXT
  OCR
  DOCX
  XLSX
  TEXT
  NONE
}

/// Text extracted from a document version by the background indexer, searchable through `search`.
model DocumentText {
  id         String                   @id @default(cuid())
  projectId  String
  project    Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId  String                   @unique
  version    DocumentVersion          @relation(fields: [versionId], references: [id], onDelete: Cascade)
  status     TextIndexStatus          @default(PENDING)
  method     TextIndexMethod?
  /// normalised text, capped (see MAX_TEXT_CHARS)
  text       String                   @default("")
  chars      Int                      @default(0)
  pages      Int?
  error      String?
  attempts   Int                      @default(0)
  startedAt  DateTime?
  indexedAt  DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  /// file name (weight A) + text (weight B), written by the indexer with raw SQL
  search     Unsupported("tsvector")?

  @@index([projectId, status])
  @@index([status, updatedAt])
  @@index([search], type: Gin)
}
