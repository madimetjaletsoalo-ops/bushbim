// BushBIM core data model.
// Foundation + Project Admin. Document Control and Field Management models
// are added by later backlog items (see BACKLOG.md).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: runtime connection (on Supabase, the pooled port 6543 URL with ?pgbouncer=true).
// DIRECT_URL: direct connection used by migrations (on Supabase, the session/direct port 5432 URL).
// Locally both point at the same database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A customer organisation (e.g. the resort developer). Owns companies, roles and projects.
model Account {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  users     User[]
  companies Company[]
  roles     Role[]
  projects  Project[]
}

enum AccountRole {
  ACCOUNT_ADMIN
  USER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  /// null until the invited user sets a password
  passwordHash String?
  /// one-time token for the invite link; cleared once the password is set
  inviteToken  String?         @unique
  accountId    String
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountRole  AccountRole     @default(USER)
  createdAt    DateTime        @default(now())
  memberships  ProjectMember[]
  auditEvents  AuditEvent[]
  folders      Folder[]
  versions     DocumentVersion[]
}

/// A trade / organisation working on projects (GC, architect, MEP sub, ...).
model Company {
  id          String          @id @default(cuid())
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  trade       String?
  country     String?
  createdAt   DateTime        @default(now())
  members     ProjectMember[]

  @@unique([accountId, name])
}

model Role {
  id        String           @id @default(cuid())
  accountId String
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  members   MemberRole[]

  @@unique([accountId, name])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          String              @id @default(cuid())
  accountId   String
  account     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  type        String?
  location    String?
  country     String?
  currency    String              @default("ZAR")
  timezone    String              @default("Africa/Johannesburg")
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus       @default(ACTIVE)
  /// cover photo shown in the project list, e.g. "/projects/kruger-lodge-villas.webp"
  coverImage  String?
  createdAt   DateTime            @default(now())
  members     ProjectMember[]
  permissions ServicePermission[]
  auditEvents AuditEvent[]
  folders     Folder[]
  documents   Document[]

  @@unique([accountId, name])
}

enum AccessLevel {
  PROJECT_ADMIN
  MEMBER
}

enum MemberStatus {
  INVITED
  ACTIVE
}

model ProjectMember {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  accessLevel AccessLevel  @default(MEMBER)
  status      MemberStatus @default(INVITED)
  /// Services this member can open at all (see Service enum)
  services    Service[]
  addedAt     DateTime     @default(now())
  roles       MemberRole[]

  @@unique([projectId, userId])
}

model MemberRole {
  memberId String
  member   ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
}

enum Service {
  DOCS
  ISSUES
  CHECKLISTS
  DAILY_LOGS
}

enum SubjectType {
  USER
  ROLE
  COMPANY
}

/// Ordered: NONE < VIEWER < CREATOR < MANAGER
enum PermissionLevel {
  NONE
  VIEWER
  CREATOR
  MANAGER
}

/// Per-service permission granted to a user, role or company within a project.
/// A member's effective level is the highest grant that applies to them.
model ServicePermission {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service     Service
  subjectType SubjectType
  subjectId   String
  level       PermissionLevel

  @@unique([projectId, service, subjectType, subjectId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// ---------- Document Control ----------

/// The two top-level folders every project starts with.
enum FolderRoot {
  PLANS
  PROJECT_FILES
}

/// A folder in a project's document tree. Root folders have `root` set and no parent.
model Folder {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]    @relation("FolderTree")
  root        FolderRoot?
  name        String
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  documents   Document[]
  permissions FolderPermission[]

  @@unique([projectId, root])
  @@unique([parentId, name])
  @@index([projectId])
}

/// A named file in a folder. Uploading the same name again stacks a new version.
model Document {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId        String
  folder          Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name            String
  /// lower-cased name: "Site Plan.pdf" and "site plan.PDF" stack as one document
  nameKey         String
  /// latest version number and its size/type, kept here for listing and sorting
  currentVersion  Int               @default(1)
  size            Int               @default(0)
  contentType     String            @default("application/octet-stream")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  versions        DocumentVersion[]

  @@unique([folderId, nameKey])
  @@index([projectId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  number       Int
  /// object key in S3/MinIO (or the local storage directory)
  storageKey   String   @unique
  /// file name as uploaded for this version
  fileName     String
  size         Int
  contentType  String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([documentId, number])
}

/// Ordered: NONE < VIEW < VIEW_DOWNLOAD < UPLOAD < EDIT < MANAGE
enum FolderLevel {
  NONE
  VIEW
  VIEW_DOWNLOAD
  UPLOAD
  EDIT
  MANAGE
}

/// DEFAULT = every project member with Document Control (subjectId "*").
enum FolderSubjectType {
  DEFAULT
  USER
  ROLE
  COMPANY
}

/// A folder-level grant. Applies to the folder and its subfolders until a
/// subfolder sets its own grant for the same subject.
model FolderPermission {
  id          String            @id @default(cuid())
  folderId    String
  folder      Folder            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  subjectType FolderSubjectType
  subjectId   String
  level       FolderLevel
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([folderId, subjectType, subjectId])
  @@index([folderId])
}
